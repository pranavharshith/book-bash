[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="fighters"
3d_physics/layer_3="projectiles"
3d_physics/layer_4="pickups"
3d_physics/layer_5="camera_blockers"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
limits/opengl/max_lights_per_object=4
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
lights_and_shadows/positional_shadow/atlas_size.mobile=512
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=0
